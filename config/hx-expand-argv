#!/usr/bin/env python3

import os
import subprocess
import sys


def find_matching_paren(text: str, start: int) -> int:
    depth = 1
    i = start
    in_single = False
    in_double = False

    while i < len(text):
        ch = text[i]

        if ch == "\\":
            i += 2
            continue

        if in_single:
            if ch == "'":
                in_single = False
            i += 1
            continue

        if in_double:
            if ch == '"':
                in_double = False
            i += 1
            continue

        if ch == "'":
            in_single = True
            i += 1
            continue

        if ch == '"':
            in_double = True
            i += 1
            continue

        if ch == "$" and i + 1 < len(text) and text[i + 1] == "(":
            depth += 1
            i += 2
            continue

        if ch == ")":
            depth -= 1
            if depth == 0:
                return i
            i += 1
            continue

        i += 1

    raise ValueError("unterminated command substitution")


def run_command_substitution(command: str) -> str:
    shell = os.environ.get("SHELL") or "/bin/sh"
    result = subprocess.run(
        command,
        shell=True,
        text=True,
        capture_output=True,
        check=True,
        executable=shell,
    )
    return result.stdout.rstrip("\n")


def expand_arg(text: str) -> str:
    expanded = []
    i = 0

    while i < len(text):
        if text[i] == "\\" and i + 1 < len(text):
            expanded.append(text[i])
            expanded.append(text[i + 1])
            i += 2
            continue

        if text[i] == "$" and i + 1 < len(text) and text[i + 1] == "(":
            end = find_matching_paren(text, i + 2)
            expanded.append(run_command_substitution(text[i + 2 : end]))
            i = end + 1
            continue

        expanded.append(text[i])
        i += 1

    return os.path.expanduser(os.path.expandvars("".join(expanded)))


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: hx-expand-argv <command> [arg ...]", file=sys.stderr)
        return 2

    try:
        command = expand_arg(sys.argv[1])
        args = [expand_arg(arg) for arg in sys.argv[2:]]
    except (ValueError, subprocess.CalledProcessError) as exc:
        print(f"hx-expand-argv: {exc}", file=sys.stderr)
        return 1

    os.execvp(command, [command, *args])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
