      "  ${2:this.init();}",
      "}"
    ],
    "description": "Constructor"
  },
  "export default": {
    "prefix": "export",
    "body": "export default ${1:name};$0",
    "description": "Export default"
  },
  "export named": {
    "prefix": "exportn",
