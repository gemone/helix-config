      "  ${3:/* code */}",
      "}"
    ],
    "description": "For-of loop"
  },
  "while loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "  ${2:/* code */}",
      "}"
    ],
    "description": "While loop"
  },
  "switch": {
    "prefix": "switch",
    "body": [
