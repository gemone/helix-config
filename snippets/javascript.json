{
  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:args}) {",
      "  ${3:return null;}",
      "}"
    ],
    "description": "JavaScript function"
  },
  "arrow function": {
    "prefix": "arrow",
    "body": [
      "const ${1:name} = (${2:args}) => {",
      "  ${3:return null;}",
      "};"
    ],
    "description": "Arrow function"
  },
  "async function": {
    "prefix": "async",
    "body": [
      "async function ${1:name}(${2:args}) {",
      "  ${3:await null;}",
      "}"
    ],
    "description": "Async function"
  },
  "async arrow": {
    "prefix": "asyncawait",
    "body": [
      "const ${1:name} = async (${2:args}) => {",
      "  ${3:await null;}",
      "};"
    ],
    "description": "Async arrow function"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "  constructor(${2:args}) {",
      "    ${3:/* init */}",
      "  }",
      "}"
    ],
    "description": "JavaScript class"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
