{
  "function": {
    "prefix": "def",
    "body": ["def ${1:name}(${2:args}):", "    ${3:pass}", "$0"],
    "description": "Python function definition"
  },
  "class": {
    "prefix": "class",
    "body": ["class ${1:ClassName}:", "    def __init__(self${2:, args}):", "        ${3:pass}", "$0"],
    "description": "Python class definition"
  },
  "if __name__ == __main__": {
    "prefix": "ifmain",
    "body": ["if __name__ == \"__main__\":", "    ${1:pass}", "$0"],
    "description": "Python main guard"
  },
  "async function": {
    "prefix": "async def",
    "body": ["async def ${1:name}(${2:args}):", "    ${3:pass}", "$0"],
    "description": "Python async function"
  },
  "try except": {
    "prefix": "try",
    "body": ["try:", "    ${1:pass}", "except ${2:Exception} as ${3:e}:", "    ${4:raise}", "$0"],
    "description": "Python try-except block"
  },
  "with open": {
    "prefix": "with",
    "body": ["with open(${1:file}, '${2:r}') as ${3:f}:", "    ${4:pass}", "$0"],
    "description": "Python with open file"
  },
  "list comprehension": {
    "prefix": "for",
    "body": "[${1:x} for ${2:x} in ${3:iterable}]$0",
    "description": "Python list comprehension"
  },
  "lambda": {
    "prefix": "lambda",
    "body": "lambda ${1:x}: ${2:expression}$0",
    "description": "Python lambda function"
  },
  "pytest function": {
    "prefix": "deftest",
    "body": ["def test_${1:name}():", "    ${2:pass}", "$0"],
    "description": "Pytest test function"
  },
  "dataclass": {
    "prefix": "dataclass",
    "body": ["@dataclass", "class ${1:ClassName}:", "    ${2:field}: ${3:type}", "    $0"],
    "description": "Python dataclass"
  },
  "property": {
    "prefix": "property",
    "body": ["@property", "def ${1:name}(self):", "    return self._${1:name}", "", "@${1:name}.setter", "def ${1:name}(self, value):", "    self._${1:name} = value", "$0"],
    "description": "Python property decorator"
  },
  "dict comprehension": {
    "prefix": "dictfor",
    "body": "{${1:k}: ${2:v} for ${3:k, v} in ${4:iterable.items()}}$0",
    "description": "Python dict comprehension"
  },
  "enumerate": {
    "prefix": "enumerate",
    "body": "for ${1:i}, ${2:item} in enumerate(${3:iterable}):\n    ${4:pass}$0",
    "description": "Python enumerate"
  },
  "zip": {
    "prefix": "zip",
    "body": "for ${1:a}, ${2:b} in zip(${3:list1}, ${4:list2}):\n    ${5:pass}$0",
    "description": "Python zip"
  }
}
